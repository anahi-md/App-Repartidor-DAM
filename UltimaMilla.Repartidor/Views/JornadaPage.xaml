<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UltimaMilla.Repartidor.Models"
             x:Class="UltimaMilla.Repartidor.Views.JornadaPage"
             Title="Mi Jornada">

    <ContentPage.Resources>
        <ResourceDictionary>
            
            <!-- Estilo para border -->
            <Style TargetType="Border">
                <Setter Property="Stroke" Value="#E0E0E0"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="10"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="5">

        <!-- Encabezado saludo al repartidor -->
        <VerticalStackLayout Spacing="4">
            <Label x:Name="SaludoLabel"
                     FontSize="24" FontAttributes="Bold"/>
            <Label x:Name="FechaLabel"
                     FontSize="14" TextColor="Gray"/>
        </VerticalStackLayout>
        
        <Button Grid.Column="1" Text="Actualizar" Clicked="OnUpdateClicked" Padding="10,4" 
                HorizontalOptions="End" VerticalOptions="Center" BackgroundColor="#1C7293" TextColor="White"/>

        <!-- Tarjeta de resumen del dia-->
        <Border Grid.Row="1" Stroke="#1C7293" StrokeThickness="1"
                Padding="16" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="4">
                <Label Text="Entregas de hoy" FontSize="14" TextColor="Gray"/>
                <Label x:Name="TotalLabel"
                       FontSize="32" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Stroke="#1C7293" StrokeThickness="1"
                Padding="16" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="4">
                <Label Text="Entregas completadas" FontSize="14" TextColor="Gray"/>
                <Label x:Name="ComplLabel"
                       FontSize="32" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Border>

        <!-- Aqui ira la lista de paradas-->
        <CollectionView x:Name="ParadasView" Grid.Row="2" Grid.ColumnSpan="2">
            <!-- EmptyView: se muestra solo cuando la coleccion está vacía-->
            <CollectionView.EmptyView>
                <Label Text="No hay paradas para hoy" FontSize="18" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Parada">
                    <Border Padding="14" Margin="0,4" StrokeShape="RoundRectangle 10" Stroke="#E0E0E0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                            <!-- Toque en toda la fila -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnParadaTapped" />
                            </Grid.GestureRecognizers>
                            
                            <!-- Numero de paradas -->
                            <Border Grid.Column="0" BackgroundColor="#1C7293"
                            WidthRequest="34" HeightRequest="34"
                                StrokeShape="RoundRectangle 17">
                                <Label Text="{Binding Numero}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="White"/>
                            </Border>

                            <!-- Cliente + direccion-->
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Cliente}" Style="{StaticResource ClienteLabel}" />
                                <Label Text="{Binding Direccion}" Style="{StaticResource TextoSecundario}" />
                            </VerticalStackLayout>

                            <!-- Estado -->
                            <Label Grid.Column="2" Text="{Binding Estado}"
                                   FontSize="12" VerticalOptions="Center">
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextColor" Value="Black"/>
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Pendiente">
                                                <Setter Property="TextColor" Value="#FFA500"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Entregada">
                                                <Setter Property="TextColor" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
      
</ContentPage>