<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UltimaMilla.Repartidor.Models"
             xmlns:vm="clr-namespace:UltimaMilla.Repartidor.ViewModels"
             x:DataType="vm:JornadaViewModel"
             x:Class="UltimaMilla.Repartidor.Views.JornadaPage"
             Title="Mi Jornada">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Border">
                <Setter Property="Stroke" Value="#E0E0E0"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="20" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="5">

        <!-- Encabezado saludo al repartidor -->
        <VerticalStackLayout Spacing="4">
            <Label Text="{Binding Saludo}"
                     FontSize="24" FontAttributes="Bold"/>
            <Label x:Name="FechaLabel" Style="{StaticResource TextoSecundario}"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Column="1" Spacing="3">
            <Button Text="Actualizar" Command="{Binding RefrescaParadasCommand}" Padding="10,4" HorizontalOptions="End"/>
            <ActivityIndicator IsRunning="{Binding EstaCargando}" IsVisible="{Binding EstaCargando}" HorizontalOptions="End"/>
            <Label Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding MensajeEstado}"
                Style="{StaticResource TextoSecundario}" FontSize="12"
                HorizontalOptions="End" VerticalOptions="Center"/>
        </VerticalStackLayout>
        
        <!-- Tarjeta de resumen del dia-->
        <Border Grid.Row="1" Style="{StaticResource BorderPrincipal}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Entregas de hoy" Style="{StaticResource TextoSecundario}"/>
                <Label Text="{Binding TotalEntregas}"
                       FontSize="32" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource BorderPrincipal}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Entregas completadas" Style="{StaticResource TextoSecundario}"/>
                <Label Text="{Binding EntregasCompletadas}"
                       FontSize="32" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Border>

        <!-- Aqui ira la lista de paradas-->
        <CollectionView ItemsSource="{Binding Paradas}" Grid.Row="2" Grid.ColumnSpan="2">
            <!-- EmptyView: se muestra solo cuando la coleccion está vacía-->
            <CollectionView.EmptyView>
                <Label Text="No hay paradas para hoy" FontSize="18" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Parada">
                    <Border Padding="14" Margin="0,4" StrokeShape="RoundRectangle 10" Stroke="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray400}}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                            <!-- Toque en toda la fila -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnParadaTapped" />
                            </Grid.GestureRecognizers>
                            
                            <!-- Numero de paradas -->
                            <Border Grid.Column="0" BackgroundColor="#1C7293" WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17">
                                <Label Text="{Binding Numero}"
                                       FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White"/>
                            </Border>

                            <!-- Cliente + direccion-->
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Cliente}" Style="{StaticResource ClienteLabel}" />
                                <Label Text="{Binding Direccion}" Style="{StaticResource TextoLists}" />
                            </VerticalStackLayout>

                            <!-- Estado -->
                            <Label Grid.Column="2" Text="{Binding Estado}"
                                   FontSize="12" VerticalOptions="Center">
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextColor" Value="Black"/>
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Pendiente">
                                                <Setter Property="TextColor" Value="#FF8811"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Estado}" Value="Entregada">
                                                <Setter Property="TextColor" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
      
</ContentPage>